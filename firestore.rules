rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Branding settings - Read by everyone, Write by admin
    match /settings/branding {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.email == 'admin@reqflow-mail.com' || 
         request.auth.token.email == 'visionsibanda17@gmail.com');
    }
  }
}
